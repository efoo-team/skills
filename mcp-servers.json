{
  "version": 1,
  "servers": {
    "playwright": {
      "description": "ブラウザ自動化・E2E 操作",
      "package": "@playwright/mcp",
      "pin": "0.0.79",
      "definition": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "--prefer-offline", "--browser=chrome-beta", "@playwright/mcp@0.0.79"],
        "env": {}
      },
      "targets": {
        "claude-code": { "mode": "sync", "scope": "user" },
        "opencode": { "mode": "sync" },
        "codex": { "mode": "verify" }
      },
      "warmup": { "npxCache": true, "browsers": ["chromium"] }
    }
  },
  "retired": []
}
